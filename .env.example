# ---------------------------------------------------------------------------
# Vision Suite — environment template.
# Copy this file to .env and fill in your own values.
# ---------------------------------------------------------------------------

# --- CVAT (Annotation Studio: import tasks, upload annotations, class counts) ---
CVAT_URL=https://app.cvat.ai/
CVAT_USERNAME=
CVAT_PASSWORD=
CVAT_ORG_SLUG=visionify

# --- Azure AI Foundry (Inference Web App: "AI analyze" on a person crop) ---
AZURE_FOUNDRY_API_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_FOUNDRY_API_TOKEN=
AZURE_FOUNDRY_DEPLOYMENT=gpt-5-mini
AZURE_FOUNDRY_API_VERSION=2025-04-01-preview

# --- Convex (backend database — call deployment functions from the app) ---
# Your deployment URL from the Convex dashboard, e.g. https://happy-otter-123.convex.cloud
CONVEX_URL=https://<your-deployment>.convex.cloud
# Server-identity secret sent with every write. Must MATCH the value set on the
# deployment:  npx convex env set CONVEX_SHARED_SECRET <same-value>
CONVEX_SHARED_SECRET=
# Auth token the app sends to call authenticated Convex functions (set_auth).
# Unused with the server-identity model above; leave blank.
CONVEX_AUTH_TOKEN=
# Deploy key for pushing the convex/ functions non-interactively (npx convex deploy).
# Only needed for CI/scripted deploys; `npx convex dev` uses interactive login instead.
CONVEX_DEPLOY_KEY=

# --- Auth (login system) ---
# Signs the session cookie. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# The one admin who signs in with a password (everyone else uses Google).
AUTH_ADMIN_EMAIL=you@company.com
# Hash of the admin password. Generate:
#   python3 -c "from werkzeug.security import generate_password_hash as g;print(g('YOUR_PASSWORD'))"
AUTH_ADMIN_PASSWORD_HASH=
# Google OAuth — create a "Web application" OAuth client in Google Cloud Console,
# add this redirect URI to it, and paste the client id/secret below:
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL used to build the OAuth redirect (must match what you registered).
AUTH_REDIRECT_BASE=http://localhost:8000