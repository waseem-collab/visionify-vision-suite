# --- Python ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Node / Convex ---------------------------------------------------------
node_modules/
# Convex codegen + CLI-local deployment config (regenerated by `npx convex dev`)
convex/_generated/
.env.local
# Convex "AI files" — assistant helper docs/skills the CLI auto-installs
# (regenerate with `npx convex ai-files install`). Not part of the app.
.agents/
.claude/skills/
skills-lock.json
AGENTS.md
CLAUDE.md

# --- Editor / tooling ------------------------------------------------------
.claude/settings.local.json
.vscode/
.idea/
.DS_Store

# --- Secrets (keep .env.example, never .env) -------------------------------
.env

# --- Model weights (too large for git — keep locally, or use LFS/a release) --
models/
*.pt
*.pth
*.onnx
*.engine

# --- Media ----------------------------------------------------------------
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v

# --- Datasets (images/labels live outside the repo) -------------------------
# The studio opens whatever folder you point it at; nothing image-shaped is
# tracked here. sample_dataset/ is a local convenience only.
sample_dataset/
dataset/
datasets/

# --- Generated output ------------------------------------------------------
# Every tool's runtime output lives under data/ (see core/paths.py):
# imports/ validation/ crops/ exports/ person_crops/ crop_reports/
# disagreement_frames/
data/

# --- Per-user runtime state (remembered inputs, settings, caches, history) ---
.state/

# Seed data (customer/company names + thumbnail URLs) — kept local; the
# registry itself lives in Convex. Re-seed with cameras:seed / setThumbnails.
seed/
